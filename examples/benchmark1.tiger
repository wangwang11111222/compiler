/* Test: benchmark program 1 */

program benchmark1
let
begin

    function main()
    begin
        let
            var a : int := 0;
            var b : int := 1;
            
            var i : int := 0;
        begin
            a := a + b;
            
            while (i < 6) do
                a := a + b;

                if (i < 3) then
                    a := a + b;
                else
                    a := a - b;
                endif;

                a := a + b;
                
                i := i + 1;
            enddo;
            
            printi(a);
        end
    end

end
